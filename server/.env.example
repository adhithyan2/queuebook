PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/queuebook
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

# Direct mobile notifications (SMS/WhatsApp) - optional for development
# Provider currently supported: twilio
# When unset, messages are logged to the server console and recorded as 'console' delivery.
SMS_PROVIDER=console
# Channel: sms or whatsapp
SMS_CHANNEL=sms
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
# Twilio sender number, e.g. +1234567890 (SMS) or whatsapp:+1234567890 (WhatsApp)
TWILIO_SMS_FROM=+1234567890
TWILIO_WHATSAPP_FROM=whatsapp:+1234567890

# Web Push (browser) notifications - VAPID keys
# Generate once with: npx web-push generate-vapid-keys
# If unset, the server auto-generates keys and saves them to server/.vapid-keys.json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@queuebook.app
